<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="it.unina.frontend.controller.LoginController"
           style="-fx-background-color: linear-gradient(to bottom right, #2c3e50, #3498db);"
           prefWidth="900" prefHeight="600">

    <VBox alignment="CENTER" spacing="25.0" maxWidth="420" maxHeight="520"
          style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40;">

        <effect>
            <DropShadow color="#00000040" radius="20" spread="0.1" offsetY="5"/>
        </effect>

        <VBox alignment="CENTER" spacing="10">
            <StackPane style="-fx-background-color: #e8f6fd; -fx-background-radius: 50; -fx-min-width: 80; -fx-min-height: 80; -fx-max-width: 80; -fx-max-height: 80;">
                <FontIcon iconLiteral="fas-bug" iconSize="40" iconColor="#3498db"/>
            </StackPane>

            <Text text="Bentornato!" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-fill: #2c3e50;">
                <font>
                    <Font size="28.0"/>
                </font>
            </Text>
            <Text text="Accedi per gestire le segnalazioni" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-fill: #7f8c8d; -fx-font-size: 14px;"/>
        </VBox>

        <VBox spacing="15" alignment="CENTER_LEFT">

            <VBox spacing="5">
                <Label text="Email" style="-fx-text-fill: #34495e; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: #f1f2f6; -fx-background-radius: 30; -fx-padding: 10 15;">
                    <FontIcon iconLiteral="fas-envelope" iconColor="#bdc3c7" iconSize="16"/>
                    <TextField fx:id="emailField" promptText="nome@esempio.com"
                               style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-prompt-text-fill: #95a5a6;"
                               HBox.hgrow="ALWAYS">
                        <font>
                            <Font size="14.0"/>
                        </font>
                    </TextField>
                </HBox>
            </VBox>

            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Password" style="-fx-text-fill: #34495e; -fx-font-weight: bold; -fx-font-size: 12px;" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: #f1f2f6; -fx-background-radius: 30; -fx-padding: 10 15;">
                    <FontIcon iconLiteral="fas-lock" iconColor="#bdc3c7" iconSize="16"/>
                    <PasswordField fx:id="passwordField" promptText="••••••••"
                                   style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-prompt-text-fill: #95a5a6;"
                                   HBox.hgrow="ALWAYS">
                        <font>
                            <Font size="14.0"/>
                        </font>
                    </PasswordField>
                </HBox>
            </VBox>
        </VBox>

        <Label fx:id="errorLabel" text="" textFill="#e74c3c" wrapText="true" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

        <Button text="ACCEDI" onAction="#onLoginButtonClick" defaultButton="true"
                maxWidth="Infinity" prefHeight="45"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 30; -fx-font-size: 14px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(52, 152, 219, 0.4), 10, 0, 0, 4);">
        </Button>

    </VBox>
</StackPane>