<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="it.unina.frontend.controller.LoginController"
           style="-fx-background-color: #f0f2f5;">

    <VBox alignment="CENTER" spacing="20.0" maxWidth="400" maxHeight="450"
          style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);">

        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
        </padding>

        <VBox alignment="CENTER" spacing="5">
            <FontIcon iconLiteral="fas-user-circle" iconSize="64" iconColor="#0d6efd"/>
            <Text text="Benvenuto" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #333;"/>
            <Text text="Accedi al gestionale" style="-fx-font-size: 14px; -fx-fill: #666;"/>
        </VBox>

        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Email" style="-fx-font-weight: bold;"/>
            <HBox alignment="CENTER_LEFT" style="-fx-border-color: #ccc; -fx-border-radius: 5; -fx-background-radius: 5; -fx-background-color: white;">
                <padding><Insets left="10"/></padding>
                <FontIcon iconLiteral="fas-envelope" iconColor="#999"/>
                <TextField fx:id="emailField" promptText="inserisci la tua email"
                           style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Password" style="-fx-font-weight: bold;"/>
            <HBox alignment="CENTER_LEFT" style="-fx-border-color: #ccc; -fx-border-radius: 5; -fx-background-radius: 5; -fx-background-color: white;">
                <padding><Insets left="10"/></padding>
                <FontIcon iconLiteral="fas-lock" iconColor="#999"/>
                <PasswordField fx:id="passwordField" promptText="••••••••"
                               style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <Label fx:id="errorLabel" text="" textFill="RED" wrapText="true" style="-fx-font-size: 12px;"/>

        <Button text="ACCEDI" onAction="#onLoginButtonClick" defaultButton="true"
                style="-fx-background-color: #0d6efd; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                maxWidth="Infinity" prefHeight="40">
        </Button>

    </VBox>
</StackPane>