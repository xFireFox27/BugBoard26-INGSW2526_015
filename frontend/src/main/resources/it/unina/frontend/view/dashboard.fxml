<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.unina.frontend.controller.DashboardController"
      spacing="20" style="-fx-padding: 30; -fx-background-color: #ecf0f1;"
      VBox.vgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="15">
        <StackPane style="-fx-background-color: #e8f6fd; -fx-background-radius: 50; -fx-min-width: 50; -fx-min-height: 50;">
            <FontIcon iconLiteral="fas-chart-line" iconSize="24" iconColor="#3498db"/>
        </StackPane>
        <VBox>
            <Text text="Dashboard" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #2c3e50;"/>
            <Text text="Panoramica e gestione delle segnalazioni" style="-fx-font-size: 13px; -fx-fill: #95a5a6;"/>
        </VBox>

        <HBox HBox.hgrow="ALWAYS" />

        <Label fx:id="welcomeLabel" text="Benvenuto" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
    </HBox>

    <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
        <effect>
            <DropShadow color="#0000000d" radius="10" offsetY="2"/>
        </effect>

        <children>
            <Label text="FILTRA SEGNALAZIONI" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #b2b2b2; -fx-padding: 0 0 10 0;"/>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="Stato" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <ComboBox fx:id="filterStatus" prefWidth="140"
                              style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Tipo" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <ComboBox fx:id="filterType" prefWidth="140"
                              style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Priorità" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <ComboBox fx:id="filterPriority" prefWidth="120"
                              style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5;"/>
                </VBox>

                <HBox style="-fx-border-color: #ecf0f1; -fx-border-width: 0 1 0 0;" maxHeight="35">
                    <HBox.margin><Insets left="10" right="10"/></HBox.margin>
                </HBox>

                <VBox spacing="5">
                    <Label text="Ordina per" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <ComboBox fx:id="sortCombo" prefWidth="140"
                              style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5;"/>
                </VBox>

                <HBox HBox.hgrow="ALWAYS" />

                <HBox alignment="BOTTOM_RIGHT" spacing="10">
                    <Button text="Reset" onAction="#resetFilters" minWidth="-Infinity"
                            style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-text-fill: #7f8c8d; -fx-cursor: hand;">
                        <graphic><FontIcon iconLiteral="fas-undo" iconColor="#95a5a6"/></graphic>
                        <padding><Insets top="8" right="15" bottom="8" left="15"/></padding>
                    </Button>

                    <Button text="Applica Filtri" onAction="#refreshTable" minWidth="-Infinity"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;">
                        <graphic><FontIcon iconLiteral="fas-filter" iconColor="WHITE"/></graphic>
                        <effect>
                            <DropShadow color="#3498db40" radius="10" offsetY="3"/>
                        </effect>
                        <padding><Insets top="8" right="20" bottom="8" left="20"/></padding>
                    </Button>
                </HBox>
            </HBox>
        </children>
    </VBox>

    <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 0;" VBox.vgrow="ALWAYS">
        <effect>
            <DropShadow color="#0000000d" radius="10" offsetY="2"/>
        </effect>

        <TableView fx:id="issuesTable" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-border-width: 0;">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colTitle" text="Titolo" prefWidth="350"/>
                <TableColumn fx:id="colAuthor" text="Autore" prefWidth="150"/>
                <TableColumn fx:id="colState" text="Stato" prefWidth="120" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colPriority" text="Priorità" prefWidth="100" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colType" text="Tipo" prefWidth="120" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colDate" text="Data" prefWidth="160" style="-fx-alignment: CENTER;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
        </TableView>
    </VBox>

</VBox>