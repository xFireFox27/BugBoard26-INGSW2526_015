<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.unina.frontend.controller.AddIssueController"
      alignment="CENTER" spacing="20"
      style="-fx-padding: 40; -fx-background-color: #ecf0f1;"
      prefWidth="800" prefHeight="600">

    <VBox spacing="15" maxWidth="600"
          style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

        <HBox alignment="CENTER_LEFT" spacing="10">
            <FontIcon iconLiteral="fas-plus-circle" iconSize="24" iconColor="#2ecc71"/>
            <Text text="Nuova Segnalazione" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        </HBox>

        <VBox spacing="5">
            <Label text="Titolo *" style="-fx-font-weight: bold;"/>
            <TextField fx:id="titleField" promptText="Breve riassunto del problema"/>
        </VBox>

        <HBox spacing="20">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Tipo *" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="typeCombo" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Priorità *" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="priorityCombo" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <VBox spacing="5">
            <Label text="Descrizione *" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="descArea" prefRowCount="5" wrapText="true" promptText="Descrivi il problema in dettaglio..."/>
        </VBox>

        <VBox spacing="5">
            <Label text="Allegato (Opzionale)" style="-fx-font-weight: bold;"/>
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #dee2e6; -fx-border-radius: 5;">
                <Button text="Seleziona File..." onAction="#onSelectFile" styleClass="btn, btn-info">
                    <graphic><FontIcon iconLiteral="fas-paperclip" iconColor="WHITE"/></graphic>
                </Button>
                <Label fx:id="fileNameLabel" text="Nessun file selezionato" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            </HBox>
        </VBox>

        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
            <Button text="Annulla" onAction="#onCancel" styleClass="btn, btn-default"/>
            <Button text="Crea Segnalazione" onAction="#onSave" styleClass="btn, btn-success" defaultButton="true">
                <graphic><FontIcon iconLiteral="fas-save" iconColor="WHITE"/></graphic>
            </Button>
        </HBox>

    </VBox>
</VBox>