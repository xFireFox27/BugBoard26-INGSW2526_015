<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.unina.frontend.controller.UserManagementController"
      alignment="CENTER" spacing="20"
      maxWidth="Infinity" maxHeight="Infinity"
      style="-fx-padding: 40; -fx-background-color: #ecf0f1;">

    <VBox maxWidth="650" spacing="20.0"
          style="-fx-background-color: white; -fx-padding: 35; -fx-background-radius: 15;">

        <effect>
            <DropShadow color="#0000001a" radius="15" spread="0.05" offsetY="5"/>
        </effect>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <StackPane style="-fx-background-color: #e6f6f8; -fx-background-radius: 50; -fx-min-width: 50; -fx-min-height: 50;">
                <FontIcon iconColor="#17a2b8" iconLiteral="fas-user-plus" iconSize="24" />
            </StackPane>
            <VBox>
                <Text text="Registra Utente" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-fill: #2c3e50;"/>
                <Text text="Crea un nuovo account per l'accesso al sistema" style="-fx-font-size: 13px; -fx-fill: #95a5a6;"/>
            </VBox>
        </HBox>

        <VBox spacing="15.0">
            <HBox spacing="15.0">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Username *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" />
                    <TextField fx:id="txtUsername" promptText="Es. m.rossi"
                               style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;" />
                </VBox>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Email *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" />
                    <TextField fx:id="txtEmail" promptText="m.rossi@email.com"
                               style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;" />
                </VBox>
            </HBox>

            <HBox spacing="15.0">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Nome *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" />
                    <TextField fx:id="txtName" promptText="Mario"
                               style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;" />
                </VBox>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Cognome *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" />
                    <TextField fx:id="txtSurname" promptText="Rossi"
                               style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;" />
                </VBox>
            </HBox>

            <HBox spacing="15.0" alignment="TOP_LEFT">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Password *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" />
                    <PasswordField fx:id="pwdPassword" promptText="••••••••"
                                   style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;" />

                    <Label fx:id="lblPasswordStatus" text="La password deve avere almeno 8 caratteri"
                           maxWidth="Infinity" alignment="CENTER_LEFT"
                           style="-fx-text-fill: #95a5a6; -fx-font-size: 11px; -fx-font-style: italic;"/>
                </VBox>

                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Ruolo *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" />
                    <ComboBox fx:id="cmbRole" maxWidth="Infinity" promptText="Seleziona..."
                              style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 5;" />
                </VBox>
            </HBox>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 10 0 0 0;">
            <Button fx:id="btnBack" mnemonicParsing="false" onAction="#handleBackAction"
                    style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #7f8c8d; -fx-cursor: hand;" text="Annulla" />

            <Button fx:id="btnCreateUser" mnemonicParsing="false" onAction="#handleCreateUserAction"
                    style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 20; -fx-cursor: hand;" text="Registra Utente">
                <graphic>
                    <FontIcon iconColor="WHITE" iconLiteral="fas-save" />
                </graphic>
                <effect>
                    <DropShadow color="#17a2b840" radius="10" offsetY="3"/>
                </effect>
            </Button>
        </HBox>
    </VBox>
</VBox>