<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unina.frontend.controller.UserManagementController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <VBox maxWidth="600.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <FontIcon iconColor="#17a2b8" iconLiteral="fas-users" iconSize="28" />
                        <Label text="Nuovo Utente">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </HBox>

                <VBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Username *" />
                                <TextField fx:id="txtUsername" promptText="Inserisci username" styleClass="form-control" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Email *" />
                                <TextField fx:id="txtEmail" promptText="Inserisci email" styleClass="form-control" />
                            </children>
                        </VBox>

                        <HBox spacing="15.0">
                            <children>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-weight: bold;" text="Nome *" />
                                        <TextField fx:id="txtName" promptText="Inserisci nome" styleClass="form-control" />
                                    </children>
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-weight: bold;" text="Cognome *" />
                                        <TextField fx:id="txtSurname" promptText="Inserisci cognome" styleClass="form-control" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Password *" />
                                <PasswordField fx:id="pwdPassword" promptText="Inserisci password" styleClass="form-control" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Ruolo *" />
                                <ComboBox fx:id="cmbRole" maxWidth="1.7976931348623157E308" promptText="Seleziona Ruolo" styleClass="form-control" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button fx:id="btnBack" mnemonicParsing="false" onAction="#handleBackAction" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4;" text="Annulla" />
                        <Button fx:id="btnCreateUser" mnemonicParsing="false" onAction="#handleCreateUserAction" styleClass="btn-success" text="Crea Utente">
                            <graphic>
                                <FontIcon iconColor="WHITE" iconLiteral="fas-check" />
                            </graphic>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>