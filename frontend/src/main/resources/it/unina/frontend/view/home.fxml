<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="it.unina.frontend.controller.HomeController"
            prefHeight="700.0" prefWidth="1100.0">

    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Label text="BugBoard" textFill="WHITE" style="-fx-font-size: 20px; -fx-font-weight: bold;">
                <graphic>
                    <FontIcon iconLiteral="fas-bug" iconColor="WHITE"/>
                </graphic>
            </Label>

            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Button text="Dashboard" maxWidth="Infinity" styleClass="btn, btn-primary"/>

                <Button fx:id="btnAddIssue" text="Nuova Segnalazione" maxWidth="Infinity"
                        onAction="#onAddIssueClick" styleClass="btn, btn-success">
                    <graphic><FontIcon iconLiteral="fas-plus" iconColor="WHITE"/></graphic>
                </Button>

                <Button fx:id="btnManageUsers" text="Gestione Utenti" maxWidth="Infinity"
                        styleClass="btn, btn-info">
                    <graphic><FontIcon iconLiteral="fas-users" iconColor="WHITE"/></graphic>
                </Button>
            </VBox>

            <Button text="Logout" maxWidth="Infinity" styleClass="btn, btn-danger" onAction="#onLogoutClick">
                <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconColor="WHITE"/></graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #ecf0f1;">

            <Label fx:id="welcomeLabel" text="Lista Segnalazioni" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: white; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                <VBox spacing="2">
                    <Label text="Stato" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;"/>
                    <ComboBox fx:id="filterStatus" prefWidth="130"/>
                </VBox>

                <VBox spacing="2">
                    <Label text="Tipo" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;"/>
                    <ComboBox fx:id="filterType" prefWidth="130"/>
                </VBox>

                <VBox spacing="2">
                    <Label text="Priorità" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;"/>
                    <ComboBox fx:id="filterPriority" prefWidth="110"/>
                </VBox>

                <VBox spacing="2">
                    <Label text="Ordina per" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;"/>
                    <ComboBox fx:id="sortCombo" prefWidth="130"/>
                </VBox>

                <HBox HBox.hgrow="ALWAYS" />

                <Button text="Applica Filtri" onAction="#refreshTable" styleClass="btn, btn-primary">
                    <graphic><FontIcon iconLiteral="fas-filter" iconColor="WHITE"/></graphic>
                </Button>

                <Button text="Reset" onAction="#resetFilters" styleClass="btn, btn-default">
                    <graphic><FontIcon iconLiteral="fas-undo" iconColor="#666"/></graphic>
                </Button>
            </HBox>

            <TableView fx:id="issuesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colTitle" text="Titolo" prefWidth="250"/>
                    <TableColumn fx:id="colAuthor" text="Autore" prefWidth="120"/>
                    <TableColumn fx:id="colState" text="Stato" prefWidth="100"/>
                    <TableColumn fx:id="colPriority" text="Priorità" prefWidth="80"/>
                    <TableColumn fx:id="colType" text="Tipo" prefWidth="100"/>
                    <TableColumn fx:id="colDate" text="Data" prefWidth="140"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

        </VBox>
    </center>
</BorderPane>