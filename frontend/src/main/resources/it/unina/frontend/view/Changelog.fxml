<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="20.0" style="-fx-background-color: #ecf0f1; -fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unina.frontend.controller.ChangelogController">
    <children>
        <VBox spacing="5.0">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Cronologia Modifiche">
                <graphic>
                    <FontIcon iconColor="#2c3e50" iconLiteral="fas-history" iconSize="24"/>
                </graphic>
            </Label>
            <Label fx:id="lblSubtitle" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Storico delle attività per questa issue" />
        </VBox>

        <TableView fx:id="tableChanges" prefHeight="400.0" prefWidth="700.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 1);">
            <columns>
                <TableColumn fx:id="colDate" prefWidth="150.0" text="Data" />
                <TableColumn fx:id="colAuthor" prefWidth="120.0" text="Autore" />
                <TableColumn fx:id="colAction" prefWidth="130.0" text="Azione" />
                <TableColumn fx:id="colDetails" prefWidth="280.0" text="Dettagli" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>